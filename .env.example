# Flask Application Configuration
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True

# Security Secret Key (Generate a random 32+ character string in production)
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Database Configuration
# Default is SQLite in the instance/ directory.
# For PostgreSQL: postgresql://username:password@localhost:5432/fakejobdetection
DATABASE_URL=sqlite:///fake_job_detection.db

# Security & Session Settings
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=86400

# Scoring Thresholds
RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_HIGH=60

